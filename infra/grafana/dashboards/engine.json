{
  "uid": "engine-overview",
  "title": "Order Book — Engine",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "10s",
  "tags": ["order-book"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders / second (by side)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (side) (rate(ob_orders_placed_total[1m]))",
          "legendFormat": "{{side}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Trades / second",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(ob_trades_executed_total[1m])",
          "legendFormat": "trades/s"
        },
        {
          "expr": "rate(ob_trades_qty_total[1m])",
          "legendFormat": "qty/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Match latency (µs)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ob_match_latency_micros_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ob_match_latency_micros_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(ob_match_latency_micros_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Book depth",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "ob_book_bid_orders",
          "legendFormat": "bid orders — {{symbol}}"
        },
        {
          "expr": "ob_book_ask_orders",
          "legendFormat": "ask orders — {{symbol}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cancels / 5m",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(increase(ob_orders_cancelled_total[5m]))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rejects / 5m",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "sum(increase(ob_orders_rejected_total[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    }
  ]
}
